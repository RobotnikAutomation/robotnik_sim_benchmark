# Benchmark-generated results.
/benchmarks/*
!/benchmarks/*/
!/benchmarks/*/.gitkeep
/benchmarks/*/*

# Python and test artifacts generated by the runner suite.
__pycache__/
*.py[cod]
.pytest_cache/

# ROS 2 workspace build artifacts.
**/build/
**/install/
**/log/

# Generated simulator projects and local runtime caches.
**/.cache/
**/.unity_cache/
